# Base URL of the Edito backend (the FastAPI app that serves /auth/*, /projects/*, /chat/*).
# 127.0.0.1 rather than localhost: the backend listens on IPv4 loopback only.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time: set them before `npm run build`.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# Optional. Where the full Edito editor lives. When set, a finished video shows an "Open in editor" link to this URL (opens in a new tab).
NEXT_PUBLIC_EDITOR_URL=

# Optional. Public origin of this site, used for canonical URLs, OpenGraph, robots and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:5174
