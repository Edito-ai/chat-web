# Base URL of the Edito backend (the FastAPI app that serves /auth/*, /projects/*, /chat/*).
# 127.0.0.1 rather than localhost: the backend listens on IPv4 loopback only.
VITE_API_BASE_URL=http://127.0.0.1:4000

# Optional. Where the full Edito editor lives. When set, a finished video shows an "Open in editor" link to this URL (opens in a new tab).
VITE_EDITOR_URL=
